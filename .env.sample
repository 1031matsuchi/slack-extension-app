# XAMPP の初期設定（ユーザー: root, パスワードなし, ポート: 3306）
#DATABASE_URL="mysql://root:@localhost:3306/slack_app_db"

# ==========================================
# AI・Google カレンダー・Cron 共通設定（全アプリ共有）
# ==========================================
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GOOGLE_SERVICE_ACCOUNT_EMAIL=YOUR_SERVICE_ACCOUNT_EMAIL
# 改行は \n のまま1行で記述するか、JSONの private_key 値をそのまま設定
GOOGLE_PRIVATE_KEY="YOUR_GOOGLE_PRIVATE_KEY"
CRON_SECRET=YOUR_CRON_SECRET

# ==========================================
# 本格配布レベル1（OAuth 2.0）用 各アプリ認証情報
# ==========================================
# 1. message-calendar-bot
MESSAGE_CALENDAR_BOT_CLIENT_ID=YOUR_MESSAGE_CALENDAR_BOT_CLIENT_ID
MESSAGE_CALENDAR_BOT_CLIENT_SECRET=YOUR_MESSAGE_CALENDAR_BOT_CLIENT_SECRET
MESSAGE_CALENDAR_BOT_SIGNING_SECRET=YOUR_MESSAGE_CALENDAR_BOT_SIGNING_SECRET
MESSAGE_CALENDAR_BOT_STATE_SECRET=YOUR_MESSAGE_CALENDAR_BOT_STATE_SECRET

# 2. calendar-reminder-bot
CALENDAR_REMINDER_BOT_CLIENT_ID=YOUR_CALENDAR_REMINDER_BOT_CLIENT_ID
CALENDAR_REMINDER_BOT_CLIENT_SECRET=YOUR_CALENDAR_REMINDER_BOT_CLIENT_SECRET
CALENDAR_REMINDER_BOT_SIGNING_SECRET=YOUR_CALENDAR_REMINDER_BOT_SIGNING_SECRET
CALENDAR_REMINDER_BOT_STATE_SECRET=YOUR_CALENDAR_REMINDER_BOT_STATE_SECRET
MESSAGE_CALENDAR_BOT_BOT_TOKEN=YOUR_MESSAGE_CALENDAR_BOT_BOT_TOKEN
MESSAGE_CALENDAR_BOT_APP_TOKEN=YOUR_MESSAGE_CALENDAR_BOT_APP_TOKEN
CALENDAR_REMINDER_BOT_BOT_TOKEN=YOUR_CALENDAR_REMINDER_BOT_BOT_TOKEN
CALENDAR_REMINDER_BOT_APP_TOKEN=YOUR_CALENDAR_REMINDER_BOT_APP_TOKEN
