SAMPLE_SLACK_APP_BOT_TOKEN=YOUR_SAMPLE_SLACK_APP_BOT_TOKEN

# XAMPP の初期設定（ユーザー: root, パスワードなし, ポート: 3306）
#DATABASE_URL="mysql://root:@localhost:3306/slack_app_db"
APP_TEST_YOCHIPEN_BOT_TOKEN=YOUR_APP_TEST_YOCHIPEN_BOT_TOKEN
APP_TEST_YOCHIPEN_APP_TOKEN=YOUR_APP_TEST_YOCHIPEN_APP_TOKEN

# ==========================================
# AI・Google カレンダー・Cron 共通設定（全アプリ共有）
# ==========================================
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GOOGLE_SERVICE_ACCOUNT_EMAIL=YOUR_SERVICE_ACCOUNT_EMAIL
# 改行は \n のまま1行で記述するか、JSONの private_key 値をそのまま設定
GOOGLE_PRIVATE_KEY="YOUR_GOOGLE_PRIVATE_KEY"
CRON_SECRET=YOUR_CRON_SECRET

# ==========================================
# 本格配布レベル1（OAuth 2.0）用 各アプリ認証情報
# ==========================================
# 1. message-calendar-bot
MESSAGE_CALENDAR_BOT_CLIENT_ID=YOUR_MESSAGE_CALENDAR_BOT_CLIENT_ID
