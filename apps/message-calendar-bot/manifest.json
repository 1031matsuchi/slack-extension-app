{
  "_metadata": {
    "major_version": 1,
    "minor_version": 1
  },
  "display_information": {
    "name": "message-calendar-bot",
    "description": "SlackメッセージからAIで予定を読み取り、Googleカレンダーに登録するBot"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": true,
      "messages_tab_enabled": false,
      "messages_tab_read_only_enabled": true
    },
    "bot_user": {
      "display_name": "message-calendar-bot",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/set-calendar",
        "description": "このワークスペースで連携するGoogleカレンダーIDを設定します",
        "usage_hint": "<GoogleカレンダーID>",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": ["channels:history", "groups:history", "reactions:read", "chat:write", "commands"]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": ["app_home_opened", "reaction_added"]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": true,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
