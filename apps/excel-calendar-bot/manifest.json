{
  "_metadata": {
    "major_version": 1,
    "minor_version": 1
  },
  "display_information": {
    "name": "excel-calendar-bot",
    "description": "ExcelファイルからAIで年間予定を読み取り、Googleカレンダーへ一括登録するBot"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": true,
      "messages_tab_enabled": false,
      "messages_tab_read_only_enabled": true
    },
    "bot_user": {
      "display_name": "excel-calendar-bot",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": ["files:read", "channels:history", "groups:history", "chat:write"]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": ["app_home_opened", "file_shared"]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": true,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
