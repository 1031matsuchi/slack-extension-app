{
  "name": "slack-extension-app",
  "version": "1.0.0",
  "description": "A scaffold template for Slack apps",
  "type": "module",
  "main": "app.js",
  "scripts": {
    "create:app": "node scripts/create-app.js",
    "dev": "node --watch app.js",
    "lint": "npx @biomejs/biome check .",
    "lint:fix": "npx @biomejs/biome check --write .",
    "start": "node app.js",
    "test": "node --test tests/**/*.spec.js"
  },
  "author": "Slack Technologies, LLC",
  "license": "MIT",
  "keywords": [
    "slack",
    "bolt",
    "slackapi"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/slack-samples/bolt-js-starter-template.git"
  },
  "bugs": {
    "url": "https://github.com/slack-samples/bolt-js-starter-template/issues"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@slack/bolt": "^5.1.0",
    "dotenv": "~18.0.4",
    "googleapis": "^190.0.0",
    "mariadb": "^3.5.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@slack/cli-hooks": "^2.0.0",
    "prisma": "^7.10.1"
  }
}
